{
  "name": "human_cli",
  "version": "1.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "vite build",
    "preview": "vite preview --host 127.0.0.1",
    "start": "npm run build && electron .",
    "start:desktop": "electron .",
    "mcp": "node adapters/mcp.mjs",
    "cli": "node adapters/cli.mjs",
    "test": "node --test tests/*.test.mjs",
    "package": "npm run build && node scripts/package.mjs",
    "test:native": "electron tests/native-smoke.mjs",
    "test:config-ui": "electron tests/native-config-ui.mjs",
    "test:lifecycle": "node tests/native-lifecycle.mjs",
    "setup": "node node_modules/electron/install.js",
    "postinstall": "npm run setup"
  },
  "devDependencies": {
    "@electron/packager": "^20.3.0",
    "electron": "^45.1.0",
    "vite": "latest"
  },
  "dependencies": {
    "@fontsource-variable/dm-sans": "^5.3.0",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "ajv": "^8.20.0",
    "lucide": "latest",
    "zod": "^4.6.7"
  },
  "main": "desktop/main.mjs",
  "engines": {
    "node": ">=22.12.0"
  },
  "description": "把用户包装成可调用的工具，帮助 AI 完成人机协作任务。",
  "repository": {
    "type": "git",
    "url": "https://github.com/fishOfOUC/human_cli.git"
  },
  "homepage": "https://github.com/fishOfOUC/human_cli#readme",
  "bugs": {
    "url": "https://github.com/fishOfOUC/human_cli/issues"
  }
}
