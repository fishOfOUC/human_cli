{
  "apiVersion": 1,
  "id": "example.cursor-capture-reply",
  "version": "1.0.0",
  "name": "截图并附言",
  "description": "截取鼠标所在屏幕，自动附上截图和一句说明，保留正在输入的草稿。",
  "icon": "camera",
  "side": "right",
  "entry": "plugin.mjs",
  "permissions": ["screen.capture"],
  "configSchema": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "message": {"type": "string", "title": "附加的话", "minLength": 1, "maxLength": 2000, "default": "已截取鼠标所在屏幕，请查收截图。"},
      "delayMs": {"type": "integer", "title": "截图前等待（毫秒）", "minimum": 0, "maximum": 10000, "default": 500},
      "autoAttach": {"type": "boolean", "title": "自动附上图片和附言", "default": true}
    }
  }
}
